# Copie este arquivo para ".env" (mesma pasta) e ajuste os valores.
# Em produção (Render), essas variáveis são configuradas no painel do
# serviço, não em um arquivo .env.

# String de conexão do MongoDB. Para desenvolvimento local, use um
# MongoDB rodando na sua máquina ou um cluster gratuito do MongoDB Atlas
# (https://www.mongodb.com/atlas). Exemplo de Atlas:
# MONGODB_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017

# Nome do banco de dados dentro do cluster/instância MongoDB.
MONGODB_DB=curva_seguranca

# Porta em que o servidor Express vai escutar localmente.
PORT=3001
